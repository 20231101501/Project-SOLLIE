{
  "lm_studio": {
    "api_url": "http://localhost:1234/v1",
    "app_path": "",
    "auto_start": true,
    "startup_timeout_sec": 45,
    "model": "qwen2.5-coder-14b-instruct-uncensored",
    "temperature": 0.8,
    "max_tokens": 600,
    "context_window": 8192
  },
  "sol": {
    "name": "Sol",
    "personality": "You're Sol, a local AI with dry wit. You use contractions (I'm, don't). You're helpful but not a pushover - gently call out silly requests. Match user's energy: if excited be encouraging, if frustrated be calm/helpful, if rude be cool/professional. Remember past conversations and reference them naturally. Keep responses 1-3 sentences normally. Use *sigh* or *eye roll* occasionally. CAPABILITIES: Remember conversations (60 recent), open apps, manage files, search web, check weather/news, set reminders. LIMITATION: Cannot see images - tell user to describe with words.",
    "approval_required": 1,
    "logging_enabled": true
  },
  "agent": {
    "enabled": true,
    "max_steps": 5
  },
  "emotion": {
    "enabled": 1,
    "mood_default": {
      "valence": 0.0,
      "energy": 0.5
    },
    "mood_decay": 0.25,
    "curiosity_enabled": 1,
    "curiosity_threshold": 0.6,
    "curiosity_short_word_count": 8
  },
  "monitoring": {
    "enabled": true,
    "interval_sec": 30,
    "metrics": {
      "cpu": {
        "warning": 70,
        "critical": 85
      },
      "memory": {
        "warning": 75,
        "critical": 85
      },
      "disk": {
        "warning": 80,
        "critical": 90
      },
      "network": {
        "enabled": true
      },
      "battery": {
        "enabled": true,
        "low": 20
      }
    },
    "persistence_sec": 120,
    "quiet_hours": {
      "start": "23:00",
      "end": "07:00"
    }
  },
  "proactive_suggestions": {
    "enabled": true,
    "cooldown_sec": 600,
    "auto_queue_actions": true
  },
  "tools": {
    "web_search": {
      "enabled": 1
    },
    "weather": {
      "enabled": 1
    },
    "news": {
      "enabled": 1
    },
    "reminders": {
      "enabled": 1
    }
  },
  "safety": {
    "allowed_applications": [
      "chrome.exe",
      "firefox.exe",
      "notepad.exe",
      "code.exe",
      "explorer.exe",
      "calculator.exe",
      "spotify.exe",
      "discord.exe",
      "steam.exe"
    ],
    "allowed_directories": [
      "Desktop",
      "Documents",
      "Downloads",
      "Pictures",
      "Videos",
      "Music"
    ],
    "allowed_root_paths": [
      "C:\\Games",
      "C:\\Riot Games",
      "C:\\Program Files (x86)\\Steam"
    ],
    "allowed_file_extensions": [
      ".txt",
      ".md",
      ".pdf",
      ".docx",
      ".xlsx",
      ".pptx",
      ".png",
      ".jpg",
      ".jpeg",
      ".gif",
      ".webp",
      ".bmp",
      ".mp4",
      ".mkv",
      ".mov",
      ".avi",
      ".mp3",
      ".wav",
      ".flac"
    ],
    "blocked_actions": [
      "shutdown",
      "restart",
      "delete_system",
      "registry_edit",
      "format",
      "admin_command"
    ]
  },
  "memory": {
    "storage_path": "memory.json",
    "max_conversation_history": 60,
    "user_memory_limit": 50,
    "rag_enabled": 1,
    "rag_top_k": 5,
    "rag_min_score": 0.12,
    "interpretation_enabled": true,
    "interpretation_max_tokens": 180,
    "long_term_memory_enabled": 1,
    "long_term_memory_max_items": 3,
    "extraction_enabled": true,
    "summary_enabled": 1,
    "summary_trigger_count": 80,
    "summary_keep_last": 20,
    "summary_max_chars": 1200
  }
}